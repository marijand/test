# Required for the personalize step (drafting tailored openers).
# Without it, personalization is skipped and a neutral opener is used.
ANTHROPIC_API_KEY=

# Optional enrichment providers. Each adapter is a no-op if its key is absent.
HUNTER_API_KEY=          # email discovery (hunter.io)
SERPAPI_KEY=             # search-based prospecting (serpapi.com)
MOZ_ACCESS_ID=           # domain authority (moz.com)
MOZ_SECRET_KEY=
